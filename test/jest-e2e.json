{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "globals": {
    "ts-jest": {
      "tsconfig": {
        "allowJs": true
      }
    }
  },
  "transformIgnorePatterns": ["node_modules/(?!uuid)"],
  "reporters": [
    "default",
    ["jest-junit", {
      "outputDirectory": "../test-results",
      "outputName": "junit-e2e.xml",
      "classNameTemplate": "{filepath}",
      "titleTemplate": "{title}"
    }]
  ]
}
